        <mxCell id="g-eyes" edge="1" parent="1" source="g-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D5B;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1B4D37;labelBackgroundColor=#FFFFFF;" target="g-yes" value="Yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-eno" edge="1" parent="1" source="g-gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C8C8C;strokeWidth=3;fontSize=12;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;" target="g-no" value="No">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B8860B;strokeWidth=2;fontSize=12;fontColor=#1F2124;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Comic Sans MS&quot;&gt;&lt;b style=&quot;&quot;&gt;The most common integration bug lives here.&lt;/b&gt;&lt;br&gt;Four markers appear on their own. The fifth does not. If likely-changes is never created by the frontend, supplying isIncomeLikelyToChange is still accepted and the value still goes downstream - but the marker is never created, the gate stays shut, and the journey silently never completes. No error explains why.&lt;/font&gt;" vertex="1">
          <mxGeometry height="90" width="955" x="45" y="555" as="geometry" />
