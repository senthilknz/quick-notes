        <mxCell id="lc-e1" edge="1" parent="1" source="lc-start" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C7AA9;strokeWidth=2;fontSize=11;fontColor=#1F2124;labelBackgroundColor=#FFFFFF;" target="lc-ns" value="&lt;font face=&quot;Courier New&quot; style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;POST /personal-lending&lt;br&gt;(always forced on create)&lt;/b&gt;&lt;/font&gt;">
