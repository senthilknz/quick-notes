        <mxCell id="lc-ip" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcd28;strokeColor=#d79b00;strokeWidth=2;fontSize=16;fontStyle=1;gradientColor=#ffa500;glass=1;shadow=1;" value="&lt;font face=&quot;Comic Sans MS&quot;&gt;InProgress&lt;/font&gt;" vertex="1">
