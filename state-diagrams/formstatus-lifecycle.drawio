        <mxCell id="lc-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#B8860B;strokeWidth=2;fontSize=12;fontColor=#1F2124;align=left;spacingLeft=12;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Comic Sans MS&quot;&gt;&lt;b style=&quot;&quot;&gt;The frontend never sets lendingApplyState.status.&lt;/b&gt; Every transition above is decided by the xAPI. A value sent by the frontend is overwritten or ignored, and no transition can be triggered by writing to this key directly.&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="700" x="20" y="820" as="geometry" />
        </mxCell>
        <mxCell id="lc-wire" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#5A5A5A;strokeWidth=1;fontSize=12;fontColor=#1F2124;align=left;spacingLeft=12;" value="&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Comic Sans MS&quot;&gt;&lt;b style=&quot;&quot;&gt;Wire values are case sensitive:&lt;/b&gt;&amp;nbsp;&amp;nbsp;&quot;NotStarted&quot;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&quot;InProgress&quot;&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;&quot;IsComplete&quot;&lt;/font&gt;" vertex="1">
