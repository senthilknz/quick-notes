<mxfile host="app.diagrams.net" agent="formstatus-guide" type="device">
  <diagram name="Completion gate" id="gate">
    <mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="g-title" value="The completion gate — all five markers must be IsComplete" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="800" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g-sub" value="Evaluated on every PUT, after the mutations in steps 1 and 2 have been applied." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="150" y="58" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="g-group" value="stamped together by the xAPI&lt;br&gt;on a successful finance-summary" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F8FC;strokeColor=#1D4E89;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=8;fontSize=11;fontColor=#0F2E52;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="260" height="290" as="geometry" />
        </mxCell>

        <mxCell id="g-a" value="your-income" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4E89;strokeColor=#0F2E52;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="g-b" value="fixed-commitments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4E89;strokeColor=#0F2E52;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="g-c" value="essential-living-costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4E89;strokeColor=#0F2E52;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="285" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="g-d" value="recurring-expenses" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4E89;strokeColor=#0F2E52;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="350" width="230" height="45" as="geometry" />
        </mxCell>

        <mxCell id="g-e" value="likely-changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1D4E89;strokeColor=#0F2E52;strokeWidth=3;fontColor=#FFFFFF;fontSize=13;fontFamily=Courier New;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="230" height="45" as="geometry" />
        </mxCell>
        <mxCell id="g-elabel" value="&lt;b&gt;stamped by the xAPI on PUT&lt;/b&gt;&lt;br&gt;when isIncomeLikelyToChange is supplied" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#0F2E52;" vertex="1" parent="1">
          <mxGeometry x="45" y="482" width="260" height="40" as="geometry" />
        </mxCell>

        <mxCell id="g-gate" value="All five&lt;br&gt;= IsComplete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#3C3F44;strokeColor=#1F2124;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="245" width="210" height="125" as="geometry" />
        </mxCell>

        <mxCell id="g-yes" value="lendingApplyState.status&lt;br&gt;= &quot;IsComplete&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D5B;strokeColor=#1B4D37;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="195" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g-yesn" value="Journey complete. Idempotent —&lt;br&gt;a repeat PUT is a no-op." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1B4D37;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="257" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="g-no" value="No status change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5A5A5A;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="350" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g-non" value="Stays InProgress. No error is returned —&lt;br&gt;the request succeeds either way." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A5A5A;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="720" y="402" width="280" height="30" as="geometry" />
        </mxCell>

        <mxCell id="g-ea" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4E89;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-a" target="g-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-eb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4E89;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-b" target="g-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-ec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4E89;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-c" target="g-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-ed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4E89;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="g-d" target="g-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-ee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D4E89;strokeWidth=3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g-e" target="g-gate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="g-eyes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2E7D5B;strokeWidth=3;fontSize=12;fontStyle=1;fontColor=#1B4D37;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g-gate" target="g-yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g-eno" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8C8C8C;strokeWidth=2;fontSize=12;fontColor=#5A5A5A;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="g-gate" target="g-no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="g-note" value="&lt;b&gt;likely-changes is the odd one out.&lt;/b&gt;&lt;br&gt;All five markers are xAPI-owned and the frontend creates none of them — but the first four are stamped together by a successful finance-summary, while likely-changes is stamped separately on PUT. That is why an application can have a successful categorised report and still sit at InProgress: four markers are set, the fifth is waiting on the customer answering the income-change question." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EFF7;strokeColor=#1D4E89;strokeWidth=2;fontSize=12;fontColor=#1F2124;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="45" y="555" width="955" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
