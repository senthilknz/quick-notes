<mxfile host="app.diagrams.net" agent="formstatus-guide" type="device">
  <diagram name="Journey flow" id="flow">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fl-title" value="One journey, call by call" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1F2124;" vertex="1" parent="1">
          <mxGeometry x="230" y="20" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="fl-sub" value="The happy path. Watch the formStatus grow." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="230" y="58" width="440" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fl-hdr1" value="THE CALL" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="420" height="20" as="geometry" />
        </mxCell>
        <mxCell id="fl-hdr2" value="formStatus AFTER THE CALL" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#5A5A5A;" vertex="1" parent="1">
          <mxGeometry x="520" y="95" width="500" height="20" as="geometry" />
        </mxCell>

        <mxCell id="fl-1" value="&lt;b&gt;1. POST /personal-lending&lt;/b&gt;&lt;br&gt;&lt;br&gt;Send: {} or FE-owned keys&lt;br&gt;Plus: isJointApplication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8C8C8C;strokeColor=#5A5A5A;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="125" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-1s" value="status = &lt;b&gt;NotStarted&lt;/b&gt;&lt;br&gt;eligibility block added&lt;br&gt;&lt;br&gt;&lt;i&gt;section markers: none yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#8C8C8C;strokeWidth=2;fontColor=#1F2124;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="125" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fl-2" value="&lt;b&gt;2. POST .../documents&lt;/b&gt;&lt;br&gt;&lt;br&gt;Send: formStatus + base64 PDFs&lt;br&gt;Repeat uploads: no further change" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C77700;strokeColor=#8A5300;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="305" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-2s" value="status = &lt;b&gt;InProgress&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;section markers: none yet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C77700;strokeWidth=2;fontColor=#1F2124;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="305" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fl-3" value="&lt;b&gt;3. POST .../finance-summary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Send: formStatus&lt;br&gt;Poll until 200 — 503 means not ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C77700;strokeColor=#8A5300;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="485" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-3s" value="status = &lt;b&gt;InProgress&lt;/b&gt; (unchanged)&lt;br&gt;&lt;br&gt;your-income ✓&amp;nbsp;&amp;nbsp;fixed-commitments ✓&lt;br&gt;essential-living-costs ✓&amp;nbsp;&amp;nbsp;recurring-expenses ✓&lt;br&gt;&lt;i&gt;likely-changes — stamped on PUT at step 4&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF3E7;strokeColor=#C77700;strokeWidth=2;fontColor=#1F2124;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="485" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fl-4" value="&lt;b&gt;4. PUT /personal-lending/{id}&lt;/b&gt;&lt;br&gt;&lt;br&gt;Send: formStatus + isIncomeLikelyToChange&lt;br&gt;Plus the four catalogues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E7D5B;strokeColor=#1B4D37;strokeWidth=2;fontColor=#FFFFFF;fontSize=13;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="665" width="420" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fl-4s" value="likely-changes stamped ✓&lt;br&gt;all five markers now IsComplete&lt;br&gt;&lt;br&gt;status = &lt;b&gt;IsComplete&lt;/b&gt;&lt;br&gt;&lt;i&gt;three mutations, one request&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F1EA;strokeColor=#2E7D5B;strokeWidth=2;fontColor=#1F2124;fontSize=12;align=left;spacingLeft=15;" vertex="1" parent="1">
          <mxGeometry x="520" y="665" width="500" height="110" as="geometry" />
        </mxCell>

        <mxCell id="fl-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C7AA9;strokeWidth=3;" edge="1" parent="1" source="fl-1" target="fl-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C7AA9;strokeWidth=3;" edge="1" parent="1" source="fl-2" target="fl-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fl-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#4C7AA9;strokeWidth=3;" edge="1" parent="1" source="fl-3" target="fl-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fl-side" value="&lt;b&gt;The frontend creates no section markers.&lt;/b&gt;&lt;br&gt;&lt;br&gt;All five are xAPI-owned: four are stamped at step 3,&lt;br&gt;likely-changes is created and stamped at step 4.&lt;br&gt;The frontend only echoes formStatus back each time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EFF7;strokeColor=#1D4E89;strokeWidth=2;fontSize=11;fontColor=#0F2E52;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="805" width="420" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fl-echo" value="&lt;b&gt;At every step:&lt;/b&gt; send back the exact formStatus string from the previous response. The response is always the source of truth — no follow-up GET is needed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F0F0;strokeColor=#5A5A5A;strokeWidth=2;fontSize=12;fontColor=#1F2124;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="520" y="805" width="500" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
